{
  "name": "dsh-game-copilot",
  "version": "0.1.0",
  "description": "打游戏时按住热键说话的桌宠助理：看一眼当前画面回答问题，气泡显示并语音播报。支持本地语音识别/合成与任意 OpenAI 兼容端点。",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<你的账号>/dsh-game-copilot.git"
  },
  "homepage": "https://github.com/<你的账号>/dsh-game-copilot#readme",
  "bugs": {
    "url": "https://github.com/<你的账号>/dsh-game-copilot/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "runtime/overlay",
    "assets/webm",
    "assets/screenshot-1.png",
    "screenshots.json",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "game",
    "game-companion",
    "desktop-pet",
    "vision",
    "voice",
    "asr",
    "tts",
    "copilot",
    "floating-widget",
    "cordis"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
